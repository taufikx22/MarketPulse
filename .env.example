# ==========================================
# MarketPulse Environment Configuration
# ==========================================

# Database Connections
# For PostgreSQL (production & Docker default):
DATABASE_URL=postgresql+asyncpg://marketpulse:marketpulse@localhost:5432/marketpulse
DATABASE_URL_SYNC=postgresql://marketpulse:marketpulse@localhost:5432/marketpulse
# For local SQLite development (alternative):
# DATABASE_URL=sqlite+aiosqlite:///./marketpulse.db
# DATABASE_URL_SYNC=sqlite:///./marketpulse.db

# ChromaDB Vector Store
CHROMADB_HOST=localhost
CHROMADB_PORT=8000

# CORS Allowed Origins (JSON array format)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Staging Directory for Local Scraped Files
STAGING_DIR=staging

# Authentication & Clerk JWT Verification (Optional for local development)
CLERK_PUBLISHABLE_KEY=pk_test_placeholder
CLERK_SECRET_KEY=sk_test_placeholder
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
CLERK_WEBHOOK_SECRET=whsec_placeholder

# Frontend API Destination
NEXT_PUBLIC_API_URL=http://localhost:8000
